{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CLERK_WEBHOOK_SECRET",
    "BREVO_API_KEY",
    "CLERK_SECRET_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPPORT_EMAIL",
    "FROM_EMAIL",
    "BREVO_SENDER_EMAIL",
    "DATAFAST_URL",
    "DATAFAST_ENTITY_ID",
    "DATAFAST_BEARER_TOKEN",
    "DATAFAST_MID",
    "DATAFAST_TID",
    "DATAFAST_SHOPPER_ECI",
    "DATAFAST_SHOPPER_PSERV",
    "DATAFAST_SHOPPER_VERSIONDF",
    "DATAFAST_RISK_MERCHANT_NAME",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "MAINTENANCE_MODE",
    "UTESTINGA",
    "SKIP_AASA_VERIFY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
